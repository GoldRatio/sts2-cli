<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition="'$(NETCoreSdkMajorVersion)' != ''">net$(NETCoreSdkMajorVersion).0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Our GodotStubs (outputs as GodotSharp.dll to satisfy sts2.dll references) -->
    <ProjectReference Include="..\GodotStubs\GodotStubs.csproj" />
    <ProjectReference Include="..\SteamworksStubs\SteamworksStubs.csproj" />
  </ItemGroup>

  <!-- Reference game DLL and its non-Godot dependencies -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>..\..\lib\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmartFormat">
      <HintPath>..\..\lib\SmartFormat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SmartFormat.ZString">
      <HintPath>..\..\lib\SmartFormat.ZString.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sentry">
      <HintPath>..\..\lib\Sentry.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Backports">
      <HintPath>..\..\lib\MonoMod.Backports.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.ILHelpers">
      <HintPath>..\..\lib\MonoMod.ILHelpers.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\..\lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Detect if we are on the beta branch by checking for CardRewardSelection in sts2.dll. May change in future updates -->
  <Target Name="DetectBeta" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <Sts2DllPath>..\..\lib\sts2.dll</Sts2DllPath>
    </PropertyGroup>
    <Exec Command="powershell -Command &quot;if (Test-Path '$(Sts2DllPath)') { if (Select-String -Path '$(Sts2DllPath)' -Pattern 'CardRewardSelection' -Quiet) { exit 0 } } exit 1&quot;" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="IsBetaCode" />
    </Exec>
    <PropertyGroup Condition="'$(IsBetaCode)' == '0'">
      <DefineConstants>$(DefineConstants);STS2_BETA</DefineConstants>
    </PropertyGroup>
    <Message Importance="high" Text="[SIM] Branch detection: IsBeta=$(IsBetaCode) (0=Beta, 1=Normal)" />
  </Target>
</Project>
